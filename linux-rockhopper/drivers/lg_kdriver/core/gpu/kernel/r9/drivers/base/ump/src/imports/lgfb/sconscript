import os
Import('env')

# Clone the environment so changes don't affect other build files
env_lgfb = env.Clone()

if env_lgfb['v'] != '1':
	env_lgfb['MAKECOMSTR'] = '[MAKE] ${SOURCE.dir}'

# Source files required for UMP.
lgfb_src = [Glob('#kernel/drivers/base/ump/src/imports/lgfb/*.c')]

# Note: cleaning via the Linux kernel build system does not yet work
if env_lgfb.GetOption('clean') :
	makeAction=Action("cd ${SOURCE.dir} && make clean", '$MAKECOMSTR')
else:
	makeAction=Action("cd ${SOURCE.dir} && make PLATFORM=${platform} && cp ump_lgfb_import.ko $STATIC_LIB_PATH/ump_lgfb_import.ko", '$MAKECOMSTR')
# The target is ump_import_lgfb.ko, built from the source in lgfb_src, via the action makeAction
# ump_import_lgfb.ko will be copied to $STATIC_LIB_PATH after being built by the standard Linux
# kernel build system, after which it can be installed to the directory specified if
# "libs_install" is set; this is done by LibTarget.
cmd = env_lgfb.Command('$STATIC_LIB_PATH/ump_lgfb_import.ko', lgfb_src, [makeAction])

# Until we fathom out how the invoke the Linux build system to clean, we can use Clean
# to remove generated files.

patterns = ['*.mod.c', '*.o', '*.ko', '*.a', '.*.cmd', 'modules.order', '.tmp_versions', 'Module.symvers']

for p in patterns:
	Clean(cmd, Glob('#kernel/drivers/base/ump/src/imports/lgfb/%s' % p))

env_lgfb.Depends('$STATIC_LIB_PATH/ump_lgfb_import.ko', '$STATIC_LIB_PATH/ump.ko')
env_lgfb.ProgTarget('ump', cmd)
