import os
Import('env')

src = [Glob('#kernel/drivers/base/dma_buf_unified/*.c'),  Glob('#kernel/include/linux/*.h'), Glob('#kernel/drivers/base/dma_buf_unified/K*')]

env.Append( CPPPATH = '#kernel/include' )

if env.GetOption('clean') :
	env.Execute(Action("make clean", '[CLEAN] dma_buf_unified'))
	cmd = env.Command('$STATIC_LIB_PATH/dma_buf_unified.ko', src, [])
	env.KernelObjTarget('dma_buf_unified', cmd)
else:
	makeAction=Action("cd ${SOURCE.dir} && make && ( ( [ -f dma_buf_unified.ko ] && cp dma_buf_unified.ko $STATIC_LIB_PATH/ ) || touch $STATIC_LIB_PATH/dma_buf_unified.ko)", '$MAKECOMSTR')
	cmd = env.Command('$STATIC_LIB_PATH/dma_buf_unified.ko', src, [makeAction])
	env.KernelObjTarget('dma_buf_unified', cmd)

